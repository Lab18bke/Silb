{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "silb-ui",
  "local": true,
  "webviews": ["*-ui", "*-ov"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-ui-ready",
    "allow-window-snapshot",
    "allow-window-control",
    "allow-window-new",
    "allow-set-chrome-top",
    "allow-set-content-visible",
    "allow-focus-content",
    "allow-tab-new",
    "allow-tab-close",
    "allow-tab-close-others",
    "allow-tab-activate",
    "allow-tab-move",
    "allow-tab-back",
    "allow-tab-forward",
    "allow-tab-reload",
    "allow-tab-stop",
    "allow-tab-mute",
    "allow-tab-reader",
    "allow-tab-devtools",
    "allow-tab-print",
    "allow-tab-navigate",
    "allow-tab-zoom",
    "allow-tab-reopen",
    "allow-tab-duplicate",
    "allow-tab-open-popup",
    "allow-find-start",
    "allow-find-step",
    "allow-find-stop",
    "allow-overlay-show",
    "allow-overlay-hide",
    "allow-overlay-event",
    "allow-overlay-resize",
    "allow-suggest",
    "allow-history-query",
    "allow-history-delete",
    "allow-top-sites",
    "allow-bookmarks-all",
    "allow-bookmark-create",
    "allow-bookmark-update",
    "allow-bookmark-move",
    "allow-bookmark-delete",
    "allow-bookmarks-for-url",
    "allow-bookmarks-search",
    "allow-downloads-list",
    "allow-download-cancel",
    "allow-download-retry",
    "allow-download-open",
    "allow-download-reveal",
    "allow-download-remove",
    "allow-downloads-clear",
    "allow-settings-get",
    "allow-settings-set",
    "allow-pick-download-dir",
    "allow-clear-browsing-data",
    "allow-site-data-list",
    "allow-site-data-clear",
    "allow-site-settings-list",
    "allow-site-setting-set",
    "allow-site-info",
    "allow-permission-resolve",
    "allow-permissions-pending",
    "allow-app-info"
  ]
}
